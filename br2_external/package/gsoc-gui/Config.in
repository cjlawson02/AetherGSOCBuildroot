config BR2_PACKAGE_GSOC_GUI
	bool "OpenX6X00 GSOC GUI"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_PACKAGE_NETWORK_MANAGER # libnm
	depends on BR2_PACKAGE_HAS_UDEV # libudev
	select BR2_PACKAGE_LIBG90
	select BR2_PACKAGE_LIBPNG
	select BR2_PACKAGE_JPEG
	select BR2_PACKAGE_LIBSNDFILE
	select BR2_PACKAGE_DBUS
	select BR2_PACKAGE_DBUS_GLIB
	select BR2_PACKAGE_SQLITE
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_PULSEAUDIO
	select BR2_PACKAGE_LIQUID_DSP
	select BR2_PACKAGE_LIBDRM
	select BR2_PACKAGE_FFTW
	select BR2_PACKAGE_FFTW_SINGLE
	select BR2_PACKAGE_FT8LIB
	select BR2_PACKAGE_BOOST
	select BR2_PACKAGE_LIBXKBCOMMON
	help
	  OpenX6X00 built for the GSOC panel and its G90 backend (libg90).
