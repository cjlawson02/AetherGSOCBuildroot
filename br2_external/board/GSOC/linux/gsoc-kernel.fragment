# GSOC delta on top of linux-6.18 arch/arm/configs/sunxi_defconfig.
# sun7i-a20-gsoc_defconfig is the savedefconfig of sunxi_defconfig + this
# fragment; edit here, then regenerate (see that file's header).

# General
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_EXPERT=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_PREEMPT=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CMA_SIZE_MBYTES=128

# Display: sun4i-drm built in; panel/backlight/PWM as modules, loaded by
# /etc/modules-load.d/gsoc-drm.conf.
CONFIG_DRM_SUN4I=y
CONFIG_DRM_PANEL_SIMPLE=m
CONFIG_BACKLIGHT_PWM=m
CONFIG_PWM_SUN4I=m
CONFIG_DRM_FBDEV_EMULATION=y
# /dev/fb0 for the GUI's fbdev path (default FB, which nothing else selects)
CONFIG_FB_DEVICE=y
# CONFIG_DRM_SUN8I_DW_HDMI is not set
# CONFIG_DRM_PANEL_EDP is not set

# Audio: card 0 sun4i codec (Mic1 -> AF), card 1 CS4271 simple-card (IQ;
# MCLK from the fixed i2s-clk).  The Si5351 drives RF, not the codec.
CONFIG_SND_SUN4I_CODEC=y
CONFIG_SND_SUN4I_I2S=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_SOC_CS4271_I2C=m
CONFIG_COMMON_CLK_SI5351=m
CONFIG_SND_USB_AUDIO=m
# CONFIG_SND_SUN8I_CODEC is not set
# CONFIG_SND_SUN8I_CODEC_ANALOG is not set

# Front panel / touch / RTC
CONFIG_KEYBOARD_LM8323=m
CONFIG_TOUCHSCREEN_GOODIX=m
CONFIG_RTC_DRV_PCF8563=y

# Networking for NetworkManager: IPv6, Wi-Fi stack, USB Ethernet.  The
# 8821CU dongle uses mainline rtw88 (as the Armbian leave kernel did).
CONFIG_IPV6=y
# Policy routing for the NM 90-source-route dispatcher (as Armbian)
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
# Unsigned regdb: keeps keyrings, and so host OpenSSL, out.
CONFIG_CFG80211_CERTIFICATION_ONUS=y
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
CONFIG_RFKILL=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8XXXU=m
CONFIG_RTW88=m
CONFIG_RTW88_8821CU=m
CONFIG_USB_NET_DRIVERS=m
CONFIG_USB_RTL8152=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
# Android USB tethering (etc/NetworkManager/system-connections/usb-tether)
CONFIG_USB_NET_RNDIS_HOST=m

# Bluetooth for USB dongles (no on-board BT on the GSOC)
CONFIG_BT=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_HIDP=m
CONFIG_BT_HCIBTUSB=m

# USB peripherals users plug into the radio
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_UHID=m
# bluetoothd's AVRCP: a headset's or a computer's media keys (/dev/uinput)
CONFIG_INPUT_UINPUT=m
CONFIG_USB_ACM=m
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_STORAGE=m

# No V4L users (CSI disabled in DT, GUI does not use Cedrus).
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_STAGING_MEDIA is not set

# Filesystems
CONFIG_NLS_UTF8=y
CONFIG_EXFAT_FS=m
# CONFIG_NFS_FS is not set
# CONFIG_ROOT_NFS is not set

# BFQ for the SD card (udev 99-scheduler.rules)
CONFIG_IOSCHED_BFQ=y
